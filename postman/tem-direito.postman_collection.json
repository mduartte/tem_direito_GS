                ]
              }
            }
          ]
        },
        {
          "name": "Código (etapa 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/auth/painel/verificar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.ribeiro@prefeitura.sp.gov.br\",\n  \"codigo\": \"{{codigoTeste}}\",\n  \"lembrar\": false\n}"
            }
