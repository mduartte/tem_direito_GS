          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Visão geral",
          "request": {
            "method": "GET",
            "header": [
