{
  "info": {
    "name": "Tem Direito · API",
    "description": "Fluxo do cidadão, painel em duas etapas, gestão de regras, automações e assistente. Rode em ordem (Runner). Variável api = http://localhost:8081/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost:8081/api"
    },
    {
      "key": "codigo",
      "value": ""
    },
    {
      "key": "chave",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "codigoTeste",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Cidadão",
      "item": [
        {
          "name": "Avaliar respostas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/triagens/avaliar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pessoas\": 1,\n  \"idade\": 70,\n  \"pcd\": \"nao\",\n  \"renda\": 0,\n  \"aposent\": \"nao\",\n  \"criancas\": \"nao\",\n  \"grupos\": [],\n  \"cad\": \"nao\",\n  \"remedio\": \"sim\",\n  \"luz\": \"sim\",\n  \"bairro\": \"Jardim Ângela\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 e 29 benefícios', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().resultado.length).to.eql(29); });",
                  "pm.test('BPC Idoso provável', () => pm.expect(pm.response.json().resultado.find(b=>b.id==='bpci').status).to.eql('prov'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar sem consentimento (deve recusar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/triagens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respostas\": {\n    \"pessoas\": 1,\n    \"idade\": 70,\n    \"pcd\": \"nao\",\n    \"renda\": 0,\n    \"aposent\": \"nao\",\n    \"criancas\": \"nao\",\n    \"grupos\": [],\n    \"cad\": \"nao\",\n    \"remedio\": \"sim\",\n    \"luz\": \"sim\",\n    \"bairro\": \"Jardim Ângela\"\n  },\n  \"consentimento\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 sem consentimento', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar triagem anônima",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/triagens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respostas\": {\n    \"pessoas\": 1,\n    \"idade\": 70,\n    \"pcd\": \"nao\",\n    \"renda\": 0,\n    \"aposent\": \"nao\",\n    \"criancas\": \"nao\",\n    \"grupos\": [],\n    \"cad\": \"nao\",\n    \"remedio\": \"sim\",\n    \"luz\": \"sim\",\n    \"bairro\": \"Jardim Ângela\"\n  },\n  \"consentimento\": true,\n  \"autorizou\": true,\n  \"canal\": \"App\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.collectionVariables.set('codigo', j.codigo); pm.collectionVariables.set('chave', j.chave);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar com chave errada (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Chave",
                "value": "errada"
              }
            ],
            "url": "{{api}}/triagens/{{codigo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Marcar lembrete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Chave",
                "value": "{{chave}}"
              }
            ],
            "url": "{{api}}/triagens/{{codigo}}/lembretes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"2030-01-15\",\n  \"canal\": \"app\",\n  \"localNome\": \"CRAS Vila Santa Lúcia\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retorno: faltou documento",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Chave",
                "value": "{{chave}}"
              }
            ],
            "url": "{{api}}/triagens/{{codigo}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retorno\": \"faltou\",\n  \"falta\": \"Comprovante de endereço\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('travado', () => pm.expect(pm.response.json().etapa).to.eql('travado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CEP do território",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/cep/04938000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Jardim Ângela', () => pm.expect(pm.response.json().bairro).to.eql('Jardim Ângela'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pontos de atendimento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/pontos?tipo=CRAS"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('6 CRAS', () => pm.expect(pm.response.json().length).to.eql(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "Assistente: golpe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{api}}/assistente/perguntar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pergunta\": \"Me pediram um pix para liberar o Bolsa Família\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('responde', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Painel",
      "item": [
        {
          "name": "Login (etapa 1)",
          "request": {
            "method": "POST",
            "header": [
