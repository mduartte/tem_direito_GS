            "url": "{{api}}/auth/painel/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.ribeiro@prefeitura.sp.gov.br\",\n  \"senha\": \"demo2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('pede código', () => pm.expect(pm.response.json().etapa).to.eql('codigo'));",
